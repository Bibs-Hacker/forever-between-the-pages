# Forever Between the Pages
# This is a STATIC site with no build step, so runtime values live in config.js,
# not in a bundled .env. This file documents what those values are and which
# secret must NEVER reach the browser.
#
# PUBLIC (safe in config.js, shipped to the browser, protected by RLS):
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
VAPID_PUBLIC_KEY=
#
# SECRET (server-side only; use ONLY inside Supabase Edge Functions / a trusted
# backend for Web Push or admin automation — never in config.js or any frontend file):
# SUPABASE_SERVICE_ROLE_KEY=keep-this-on-the-server-only
# VAPID_PRIVATE_KEY=keep-this-on-the-server-only
